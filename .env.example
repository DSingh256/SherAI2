# VanRakshak AI - Environment Configuration

# API Configuration
APP_NAME=VanRakshak AI
APP_VERSION=0.1.0
DEBUG=False
API_HOST=0.0.0.0
API_PORT=8000

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vanrakshak

# Storage Paths
RAW_STORAGE_PATH=./storage/raw
PROCESSED_STORAGE_PATH=./storage/processed
QUARANTINE_STORAGE_PATH=./storage/quarantine
SEGMENTED_STORAGE_PATH=./storage/segmented

# Image Upload Configuration
MAX_UPLOAD_SIZE_MB=50
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,gif,tiff

# Confidence Thresholds
HIGH_CONFIDENCE_THRESHOLD=0.90
MEDIUM_CONFIDENCE_THRESHOLD=0.60
LOW_CONFIDENCE_THRESHOLD=0.00

# Quality Gate Thresholds
BLUR_THRESHOLD=100.0
MIN_BRIGHTNESS=10
MAX_BRIGHTNESS=245

# Model Configuration
MEGADETECTOR_CONFIDENCE_THRESHOLD=0.5
SPECIESNET_CONFIDENCE_THRESHOLD=0.5

# Feature Flags
ENABLE_MEGADETECTOR=True
ENABLE_SPECIESNET=True
ENABLE_OPENCLIP=False
ENABLE_SAM_SEGMENTATION=False
